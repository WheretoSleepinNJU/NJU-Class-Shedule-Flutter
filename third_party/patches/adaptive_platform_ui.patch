diff --git a/lib/src/toolbar/native_toolbar_backend.dart b/lib/src/toolbar/native_toolbar_backend.dart
new file mode 100644
index 0000000..a350420
--- /dev/null
+++ b/lib/src/toolbar/native_toolbar_backend.dart
@@ -0,0 +1,54 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import '../widgets/adaptive_app_bar.dart';
+import 'toolbar_registry.dart';
+
+/// App-owned native chrome installed once above the navigator.
+/// Unsupported app bars keep the standard Material implementation.
+class NativeToolbarBackend {
+  const NativeToolbarBackend({
+    required this.builder,
+    required this.height,
+    required this.supports,
+    this.preferredToolbarHeight,
+  });
+  final Widget Function(BuildContext context, ToolbarRegistry registry) builder;
+  final ValueListenable<double> height;
+
+  /// Native title band height, excluding status bar and optional categories.
+  final double? preferredToolbarHeight;
+  final bool Function(AdaptiveAppBar appBar) supports;
+}
+
+class NativeToolbarScope extends InheritedWidget {
+  const NativeToolbarScope({
+    super.key,
+    required this.backend,
+    required super.child,
+  });
+  final NativeToolbarBackend? backend;
+  static NativeToolbarBackend? maybeOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<NativeToolbarScope>()?.backend;
+  @override
+  bool updateShouldNotify(NativeToolbarScope oldWidget) =>
+      backend != oldWidget.backend;
+}
+
+/// Padding for scrollable content that extends behind native chrome.
+/// Put this inside the scrollable's content padding, so it scrolls under the bar.
+class NativeToolbarBodyScope extends InheritedWidget {
+  const NativeToolbarBodyScope({
+    super.key,
+    required this.topInset,
+    required super.child,
+  });
+  final double topInset;
+  static double topInsetOf(BuildContext context) =>
+      context
+          .dependOnInheritedWidgetOfExactType<NativeToolbarBodyScope>()
+          ?.topInset ??
+      0;
+  @override
+  bool updateShouldNotify(NativeToolbarBodyScope oldWidget) =>
+      topInset != oldWidget.topInset;
+}
