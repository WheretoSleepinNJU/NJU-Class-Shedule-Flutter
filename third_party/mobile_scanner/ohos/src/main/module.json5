{
  "module": {
    "name": "mobile_scanner",
    "type": "har",
    "deviceTypes": [
      "default",
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:request_perm",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  },
}