<?xml version="1.0" encoding="utf-8"?>
<!--
  中尺寸小组件（4x2）。
  对标 iOS 端 MediumWidgetView：左侧详细课程，右侧剩余课程列表或"我已到达"按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:baselineAligned="false">

    <!-- 左栏 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_week_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/widget_status_label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_secondary" />

            <TextView
                android:id="@+id/widget_status_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_course_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

<TextView
            android:id="@+id/widget_arrived_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_arrived_button_background"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/widget_arrived"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_empty_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 分隔线 -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_divider_background" />

    <!-- 右栏 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_right_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_remaining_courses"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary"
            android:visibility="gone" />

        <ListView
            android:id="@+id/widget_right_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:scrollbars="vertical"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:background="@android:color/transparent"
        android:overScrollMode="never" />

        <TextView
            android:id="@+id/widget_right_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:visibility="gone" />

        <!-- 右栏空状态：课程已结束 / 这就是全部啦 -->
        <LinearLayout
            android:id="@+id/widget_right_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_right_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
